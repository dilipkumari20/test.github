)

plt.xlabel("False Positive Rate")
plt.ylabel("True Positive Rate")

plt.title("ROC Curves")

plt.legend()

plt.show()

# Decision Tree visualization
X_train_transformed = tree_pipeline.named_steps[
    "preprocessor"
].transform(X_train)
#Get features
feature_names = (
    tree_pipeline
    .named_steps["preprocessor"]
    .get_feature_names_out()
)
# Plot decesion tree
plt.figure(figsize=(20, 10))

plot_tree(
    tree_pipeline.named_steps["model"],
    feature_names=feature_names,
    class_names=["Not Survived", "Survived"],
    filled=True,
    max_depth=3
)

plt.title("Decision Tree")

plt.show()

#Class balance
class_balance = y.value_counts()

print(class_balance)

print("\nClass balance percentage:")

print(
    y.value_counts(normalize=True) * 100
)
#Imbalance Strategy 1 — Baseline
baseline_model = Pipeline(
    steps=[
        ("preprocessor", preprocessor),
        (
            "model",
            LogisticRegression(
                max_iter=1000,
                random_state=42
            )
        )
    ]
)

baseline_model.fit(X_train, y_train)

baseline_pred = baseline_model.predict(X_test)

#Evalution
baseline_precision = precision_score(
    y_test,
    baseline_pred
)

baseline_recall = recall_score(
    y_test,
    baseline_pred
)

baseline_f1 = f1_score(
    y_test,
    baseline_pred
)

print(
    "Baseline:",
    baseline_precision,
    baseline_recall,
    baseline_f1
)

#Imbalance Strategy 2 — class_weight balanced
balanced_model = Pipeline(
    steps=[
        ("preprocessor", preprocessor),
        (
            "model",
            LogisticRegression(
                max_iter=1000,
                class_weight="balanced",
                random_state=42
            )
        )
    ]
)

balanced_model.fit(
    X_train,
    y_train
)

balanced_pred = balanced_model.predict(
    X_test
)
#Evalution
balanced_precision = precision_score(
    y_test,
    balanced_pred
)

balanced_recall = recall_score(
    y_test,
    balanced_pred
)

balanced_f1 = f1_score(
    y_test,
    balanced_pred
)

print(
    "Balanced:",
    balanced_precision,
    balanced_recall,
    balanced_f1
)
#SMOTE
X_train_processed = preprocessor.fit_transform(
    X_train
)

X_test_processed = preprocessor.transform(
    X_test
)
smote = SMOTE(
    random_state=42
)

X_train_smote, y_train_smote = smote.fit_resample(
    X_train_processed,
    y_train
)
#Train the model
smote_model = LogisticRegression(
    max_iter=1000,
    random_state=42
)

smote_model.fit(
    X_train_smote,
    y_train_smote
)
#prediction of the model
smote_pred = smote_model.predict(
    X_test_processed
)
#Evalution
smote_precision = precision_score(
    y_test,
    smote_pred
)

smote_recall = recall_score(
    y_test,
    smote_pred
)

smote_f1 = f1_score(
    y_test,
    smote_pred
)

print(
    "SMOTE:",
    smote_precision,
    smote_recall,
    smote_f1
)
#Imbalance comparison table
imbalance_results = pd.DataFrame({
    "Strategy": [
        "Baseline",
        "Class Weight Balanced",
        "SMOTE"
    ],

    "Precision": [
        baseline_precision,
        balanced_precision,
        smote_precision
    ],

    "Recall": [
        baseline_recall,
        balanced_recall,
        smote_recall
    ],

    "F1": [
        baseline_f1,
        balanced_f1,
        smote_f1
    ]
})

print(imbalance_results)

#Random Forest GridSearchCV
rf = RandomForestClassifier(
    random_state=42,
    oob_score=True
)
rf_pipeline = Pipeline(
    steps=[
        ("preprocessor", preprocessor),
        ("model", rf)
    ]
)
#parameter grid
param_grid = {
    "model__n_estimators": [100, 200],
    "model__max_depth": [3, 5, 10, None],
    "model__max_features": ["sqrt", "log2"]
}
#Grid search
grid_search = GridSearchCV(
